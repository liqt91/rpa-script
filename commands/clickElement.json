{
  "label": "点击元素",
  "runtime": "extension",
  "icon": "fa-hand-pointer",
  "iconColor": "text-blue-500",
  "bgColor": "bg-blue-50",
  "categoryOrder": 40,
  "commandOrder": 10,
  "description": "点击页面上的一个元素",
  "enabled": true,
  "isNew": true,
  "params": [
    {
      "name": "elementName",
      "label": "元素",
      "type": "element",
      "required": true
    },
    {
      "name": "scope",
      "label": "匹配范围",
      "type": "select",
      "options": [
        {
          "label": "当前外层元素内",
          "value": "local"
        },
        {
          "label": "全页面",
          "value": "global"
        }
      ],
      "default": "local",
      "group": "advanced"
    },
    {
      "name": "loopAnchor",
      "label": "锚点元素",
      "type": "string",
      "default": "",
      "group": "anchor"
    },
    {
      "name": "visibilityMode",
      "label": "元素可见性",
      "type": "select",
      "options": [
        {
          "label": "仅可见",
          "value": "visible"
        },
        {
          "label": "所有",
          "value": "any"
        }
      ],
      "default": "visible",
      "group": "advanced"
    }
  ],
  "pythonAction": "click",
  "handler": {
    "kind": "extension",
    "function": "doClick"
  },
  "categories": [
    "element"
  ],
  "cmd": "clickElement",
  "testTemplates": [
    {
      "name": "百度搜索按钮点击",
      "description": "打开百度，点击搜索按钮，验证页面跳转",
      "params": {
        "url": "https://www.baidu.com",
        "elementName": "search_btn"
      },
      "nodes": [
        {"cmd": "launchBrowser", "order": 1, "extra": {"browserType": "chrome", "windowVar": "browser1"}},
        {"cmd": "navigate", "order": 2, "extra": {"url": "{{url}}", "windowVar": "browser1"}},
        {"cmd": "waitForElement", "order": 3, "extra": {"elementName": "{{elementName}}", "timeout": 10, "windowVar": "browser1"}},
        {"cmd": "clickElement", "order": 4, "extra": {"elementName": "{{elementName}}", "windowVar": "browser1"}},
        {"cmd": "log", "order": 5, "extra": {"message": "点击完成"}}
      ]
    }
  ]
}