{
  "label": "点击元素",
  "runtime": "extension",
  "icon": "fa-hand-pointer",
  "iconColor": "text-blue-500",
  "bgColor": "bg-blue-50",
  "categoryOrder": 20,
  "commandOrder": 20,
  "description": "点击页面上的一个元素",
  "enabled": true,
  "isNew": true,
  "params": [
    {
      "name": "elementName",
      "label": "元素",
      "type": "element",
      "required": true
    },
    {
      "name": "scope",
      "label": "匹配范围",
      "type": "select",
      "options": [
        {
          "label": "当前外层元素内",
          "value": "local"
        },
        {
          "label": "全页面",
          "value": "global"
        }
      ],
      "default": "local",
      "group": "advanced"
    },
    {
      "name": "loopAnchor",
      "label": "锚点元素",
      "type": "string",
      "default": "",
      "group": "anchor"
    },
    {
      "name": "visibilityMode",
      "label": "元素可见性",
      "type": "select",
      "options": [
        {
          "label": "仅可见",
          "value": "visible"
        },
        {
          "label": "所有",
          "value": "any"
        }
      ],
      "default": "visible",
      "group": "advanced"
    },
    {
      "name": "humanLike",
      "label": "真实鼠标点击",
      "type": "boolean",
      "default": true,
      "group": "advanced",
      "description": "勾选：鼠标贝塞尔移动并真实点击（需浏览器窗口在前台）；不勾选：合成 click 事件（快，后台可用）"
    },
    {
      "name": "clickMethod",
      "label": "点击方式",
      "type": "select",
      "options": [
        {
          "label": "自动（真实鼠标）",
          "value": "auto"
        },
        {
          "label": "合成事件（不碰鼠标，后台可用）",
          "value": "js"
        },
        {
          "label": "仅真实鼠标（需窗口前台）",
          "value": "os"
        }
      ],
      "default": "auto",
      "group": "advanced",
      "description": "auto：真实鼠标移动+点击（兼容现状）；js：页面内合成完整鼠标事件序列（mousemove/mousedown/mouseup/click），不移动系统鼠标、后台可用，适合被遮挡元素/反爬页；os：强制真实鼠标"
    },
    {
      "name": "scrollDelayMs",
      "label": "点击前等待(ms)",
      "type": "number",
      "default": 400,
      "group": "advanced",
      "description": "滚动到元素后、点击前的拟人化等待均值（毫秒）。反爬需要更慢节奏时调大"
    },
    {
      "name": "postClickDelayMs",
      "label": "点击后等待(ms)",
      "type": "number",
      "default": 300,
      "group": "advanced",
      "description": "真实点击后的拟人化等待均值（毫秒），仅在真实鼠标点击时生效"
    }
  ],
  "pythonAction": "click",
  "handler": {
    "kind": "extension",
    "function": "doClick"
  },
  "categories": [
    "browser-element"
  ],
  "cmd": "clickElement",
  "category": "浏览器元素操作"
}