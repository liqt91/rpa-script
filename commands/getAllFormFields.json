  "params": [
    {
      "name": "includeHidden",
      "label": "包含隐藏字段",
      "type": "boolean",
      "default": false,
      "group": "advanced"
    },
    {
      "name": "includeSelect",
      "label": "包含下拉框",
      "type": "boolean",
      "default": true,
      "group": "advanced"
    },
    {
      "name": "resultVar",
      "label": "保存到变量",
      "type": "string",
      "default": "fields",
      "group": "output",
      "description": "表单字段列表（数组，含 tag/name/type/value/placeholder/label）将保存到此变量"
    }
  ],
  "categories": [
    "browser-element"
  ],
  "handler": {
    "kind": "extension",
    "source": "extension/dom_handlers_new/getAllFormFields.js"
  },
  "enabled": true
}