{
  "cmd": "getAllFormFields",
  "label": "获取所有表单字段",
  "runtime": "extension",
  "category": "浏览器元素操作",
  "icon": "fa-list-ul",
  "iconColor": "text-indigo-500",
  "bgColor": "bg-indigo-50",
  "categoryOrder": 20,
  "commandOrder": 57,
